# LLM Analysis Quiz Solver - Environment Configuration Template
# Copy this to .env and fill in with your actual values

# Your student email (used for quiz submissions)
STUDENT_EMAIL=your-email@ds.study.iitm.ac.in

# Secret string (used to verify requests from the evaluation server)
# Generate a strong random string (your teacher will provide this)
EXPECTED_SECRET=your-secret-string-here

# OpenAI API key (for calling the LLM via AiPipe proxy)
# See: https://github.com/sanand0/aipipe for details
OPENAI_API_KEY=your-aipipe-api-key-here
# LLM model name (default: gpt-4o-mini)
# Can be any model supported by the OpenAI API or AiPipe proxy
LLM_MODEL=gpt-4o-mini

# (Optional) Enable LLM retry with stricter context if first attempt returns null
# Set to "true", "1", or "yes" to enable
ENABLE_LLM_RETRY=false

# (Optional) Maximum quiz duration in seconds (default: 170, ~3 minutes)
# MAX_QUIZ_DURATION_SECS=170
